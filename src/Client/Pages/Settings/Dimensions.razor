@page "/Settings/Dimensions"
@attribute [MustHavePermission(FSHAction.View, FSHResource.Dimensions)]

@inject IStringLocalizer<Dimensions> L
@inject IDimensionsClient DimensionsClient

<FshTitle Title="@L["Dimensions"]" Description="@L["Manage Dimensions."]" />

<EntityTable @ref="_table" TEntity="DimensionDto" TId="Guid" TRequest="UpdateDimensionRequest" Context="@Context">
    <AdvancedSearchContent>
        <MudTextField Placeholder="@L["Type Filter"]" Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.FilterAlt" IconSize="Size.Medium"
            Style="flex:none!important;margin:0px!important"
            @bind-Value="SearchTypeString" TextChanged="OnTypeStringChanged" Immediate="false" />
    </AdvancedSearchContent>

    <EditFormContent>
        @if (!Context.AddEditModal.IsCreate)
        {
            <MudItem xs="12" md="12">
                <MudTextField Value="context.Id" ReadOnly DisableUnderLine Label="@L[$"Dimension Id"]" />
            </MudItem>
        }
        <MudItem xs="12" md="3">
            <MudTextField Label="@L["Order"]" For="@(() => context.Order)" @bind-Value="context.Order" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="@L["Code"]" For="@(() => context.Code)" @bind-Value="context.Code" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="@L["Name"]" For="@(() => context.Name)" @bind-Value="context.Name" T="string" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="@L["Value"]" For="@(() => context.Value)" @bind-Value="context.Value" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudTextField Label="@L["Full Name"]" For="@(() => context.FullName)" @bind-Value="context.FullName" T="string" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="@L["Native Name"]" For="@(() => context.NativeName)" @bind-Value="context.NativeName" T="string" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="@L["Full Native Name"]" For="@(() => context.FullNativeName)" @bind-Value="context.FullNativeName" T="string" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField Label="@L["Type"]" For="@(() => context.Type)" @bind-Value="context.Type" T="string" />
        </MudItem>
        <MudItem xs="12" md="9">
            <MudTextField Label="@L["Description"]" For="@(() => context.Description)" @bind-Value="context.Description" />
        </MudItem>
        <MudItem xs="12" md="3">
            <DimensionAutocomplete For="@(() => context.FatherId)" @bind-Value="context.FatherId"
                                    AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" />
        </MudItem>
        <MudItem xs="12" md="9">
        </MudItem>
        <MudItem xs="12" md="3">
            <MudCheckBox @bind-Value="context.IsActive" For="@(() => context.IsActive)" Label="@L["Active"]"></MudCheckBox>
        </MudItem>
    </EditFormContent>
</EntityTable>